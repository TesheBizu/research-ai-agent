# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/researchai

# Frontend Client URL (for CORS with credentials)
CLIENT_URL=http://localhost:5173

# Authentication & JWT Configuration (Replace with strong random secret in .env)
JWT_SECRET=replace_with_a_strong_random_jwt_secret
JWT_EXPIRES_IN=7d

# Cookie & Rate Limit Configuration
AUTH_COOKIE_NAME=researchai_token
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Cala.ai Configuration (Proposed placeholder variable names - protocol pending runtime verification)
CALA_API_KEY=your_cala_api_key_here
CALA_BASE_URL=https://api.cala.ai

# LLM Provider Configuration (Proposed placeholder variable names)
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o
